// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: resumes
// Document ID: {resumeId}
// Fields:
//   - fullName: string (required)
//   - email: string (required, email format)
//   - phone: string (optional)
//   - skills: list of strings (required)
//   - workExperience: string (optional)
//   - education: string (optional)
//   - projects: string (optional)
//   - location: string (optional)
//   - fileUrl: string (required, URL)
//   - fileName: string (required)
//   - fileType: string (required)
//   - createdAt: timestamp (required)
//   - ownerId: string (required)
//
// Collection: folders
// Document ID: {folderId}
// Fields:
//   - roleName: string (required)
//   - resumeCount: number (required)
//   - ownerId: string (required)
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    function isValidResume(data) {
      return data.fullName is string && data.fullName.size() > 0 &&
             data.email is string && data.email.size() > 0 &&
             data.primaryRole is string &&
             data.skills is list &&
             data.ownerId == request.auth.uid;
    }

    function isValidFolder(data) {
      return data.roleName is string &&
             data.ownerId == request.auth.uid;
    }

    // Resumes Collection
    match /resumes/{resumeId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if isAuthenticated() && isValidResume(request.resource.data);
      allow update: if isOwner(resource.data.ownerId) && isValidResume(request.resource.data);
      allow delete: if isOwner(resource.data.ownerId);
    }

    // Folders Collection
    match /folders/{folderId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if isAuthenticated() && isValidFolder(request.resource.data);
      allow update: if isOwner(resource.data.ownerId) && isValidFolder(request.resource.data);
      allow delete: if isOwner(resource.data.ownerId);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
